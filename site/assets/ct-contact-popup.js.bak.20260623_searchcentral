  function ensureModal() {
    if (overlay && modal) return;

    overlay = document.createElement("div");
    overlay.id = "ct-google-form-overlay";
    overlay.setAttribute("aria-hidden", "true");

    modal = document.createElement("div");
    modal.id = "ct-google-form-modal";
    modal.setAttribute("role", "dialog");
    modal.setAttribute("aria-modal", "true");

    modalHeader = document.createElement("div");
    modalHeader.id = "ct-google-form-header";
    modalHeader.textContent = "Fale com a CONT.TOOL";

    var actions = document.createElement("div");
    actions.id = "ct-google-form-actions";

    var openLink = document.createElement("a");
    openLink.id = "ct-google-form-open-link";
    openLink.href = FORM_VIEW_URL;
    openLink.target = "_blank";
    openLink.rel = "noopener noreferrer";
    openLink.textContent = "Abrir em nova aba";

    var closeBtn = document.createElement("button");
    closeBtn.id = "ct-google-form-close";
    closeBtn.type = "button";
    closeBtn.textContent = "Fechar";
    closeBtn.addEventListener("click", closeModal);

    actions.appendChild(openLink);
    actions.appendChild(closeBtn);
    modalHeader.appendChild(actions);

    var iframe = document.createElement("iframe");
    iframe.id = "ct-google-form-iframe";
    iframe.src = FORM_URL;
    iframe.title = "Formulário de contato CONT.TOOL";
    iframe.loading = "lazy";

    modal.appendChild(modalHeader);
    modal.appendChild(iframe);
    overlay.appendChild(modal);

    overlay.addEventListener("click", function (event) {
      if (event.target === overlay) closeModal();
    });

    document.body.appendChild(overlay);
  }

  function openModal(title) {
    ensureModal();
    if (modalHeader) {
      modalHeader.firstChild.textContent = title || "Fale com a CONT.TOOL";
    }
    overlay.classList.add("open");
    overlay.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
  }

  function closeModal() {
    if (!overlay) return;
    overlay.classList.remove("open");
    overlay.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  }

  function isContactTrigger(element) {
    if (!element) return false;
    if (element.dataset && element.dataset.noPopup === "true") return false;
    if (element.id === "openCalculatorModal") return false;
    if (element.closest && element.closest("#ct-calculator-section")) return false;
    if (element.closest && element.closest("#ct-contact-form-shell")) return false;

    var href = (element.getAttribute("href") || "").trim();
    var text = (element.innerText || element.textContent || "").trim();
    var ariaLabel = element.getAttribute("aria-label") || "";
    var title = element.getAttribute("title") || "";
    var mergedText = [text, ariaLabel, title].join(" ");

    if (CONTACT_TRIGGER_HREF_RE.test(href)) return true;
    return CONTACT_TRIGGER_TEXT_RE.test(mergedText);
  }

  function scrollToContactForm() {
    var target = document.getElementById("formulario-contato");
    if (!target) return;

    target.scrollIntoView({ behavior: "smooth", block: "start" });

    var firstField = target.querySelector("input,select,textarea");
    if (firstField) {
      window.setTimeout(function () {
        firstField.focus({ preventScroll: true });
      }, 500);
    }
  }

