  function updateCardContent(card) {
    var articleLinks = card.querySelectorAll("a[href^='/blog/artigos/']");
    articleLinks.forEach(function (link) {
      link.setAttribute("href", NEW_ARTICLE.slug);
    });

    var categoryLink = card.querySelector("a[href^='/blog/categoria/']");
    if (categoryLink) categoryLink.setAttribute("href", NEW_ARTICLE.categoryHref);

    var categoryBadge = categoryLink ? categoryLink.querySelector("span") : null;
    if (categoryBadge) categoryBadge.textContent = NEW_ARTICLE.category;

    var image = card.querySelector("img");
    if (image) {
      image.setAttribute("src", NEW_ARTICLE.image);
      image.setAttribute("alt", NEW_ARTICLE.title);
    }

    var title = card.querySelector("h3");
    if (title) title.textContent = NEW_ARTICLE.title;

    var excerpt = card.querySelector("p.text-gray-600");
    if (excerpt) excerpt.textContent = NEW_ARTICLE.excerpt;

    var dateNode = card.querySelector(".flex.items-center.text-xs.text-gray-500.mb-3.gap-2 span");
    if (dateNode) dateNode.textContent = NEW_ARTICLE.date;
  }

  function injectGeneralArticlesCard(root) {
    return; // desativado: artigos 5s/feimec agora vêm nativos no bundle do blog
    if (!isGeneralArticlesPage()) return;

    var scope = root || document;
    var grids = scope.querySelectorAll
      ? scope.querySelectorAll("div.grid.grid-cols-1.md\\:grid-cols-2.lg\\:grid-cols-3.gap-8")
      : [];

    if (!grids.length) {
      grids = document.querySelectorAll(
        "div.grid.grid-cols-1.md\\:grid-cols-2.lg\\:grid-cols-3.gap-8"
      );
    }

    grids.forEach(function (grid) {
      if (!grid || !grid.querySelector("a[href^='/blog/artigos/']")) return;
      if (grid.querySelector("a[href='/blog/artigos/5s-na-industria/'], a[href='/blog/artigos/5s-na-industria']")) return;

      var firstCard = grid.firstElementChild;
      if (!firstCard) return;

      var card = firstCard.cloneNode(true);
      updateCardContent(card);
      grid.insertBefore(card, grid.firstChild);
    });
  }

