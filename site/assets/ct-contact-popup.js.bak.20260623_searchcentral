  // Remove duplicatas do mesmo id (React + injeção manual podem gerar 2).
  function ctDedupe(id) {
    var els = document.querySelectorAll("#" + id);
    for (var i = 1; i < els.length; i++) {
      if (els[i] && els[i].parentNode) els[i].parentNode.removeChild(els[i]);
    }
  }

  function removeById(id) {
    var el = document.getElementById(id);
    if (el && el.parentNode) el.parentNode.removeChild(el);
  }

  // Blog (landing /blog): coloca o card do formulário à DIREITA da seção
  // "#sobre" (SOBRE A CONT.TOOL), com o conteúdo (título/texto/botão) à esquerda.
  function placeBlogForm(shell) {
    var sobre = document.getElementById("sobre");
    if (!sobre) return false;
    var inner = sobre.querySelector("div");
    if (!inner) return false;

    if (inner.getAttribute("data-ct-sobre") !== "1") {
      inner.setAttribute("data-ct-sobre", "1");
      var left = document.createElement("div");
      left.className = "ct-sobre-left";
      while (inner.firstChild) left.appendChild(inner.firstChild);
      inner.classList.remove("text-center");
      inner.classList.add("ct-sobre-grid");
      var right = document.createElement("div");
      right.className = "ct-sobre-right";
      inner.appendChild(left);
      inner.appendChild(right);
    }
    var rightCol = inner.querySelector(".ct-sobre-right");
    if (rightCol && shell.parentNode !== rightCol) rightCol.appendChild(shell);
    return true;
  }

  // Mantém calculadora + formulário ancorados no fim do conteúdo (dentro do <main>,
  // footer é irmão depois → ficam logo acima do footer). No blog landing o form vai
  // ao lado do #sobre. Roda a cada tick do observer e auto-corrige posição/duplicatas.
  function ensureBottomSections() {
    ctDedupe("ct-contact-floating-btn");
    ctDedupe("ct-contact-form-shell");
    ctDedupe("ct-contact-section");
    ctDedupe("ct-calculator-section");
    ctDedupe("ct-bottom-block");

    var main = document.querySelector("main");
    if (!main) return; // aguarda o app React montar o <main>

    var path = currentPath();
    var wantCalc = path === "/" || path === "/produtos";

    // === CASO 1: página tem o form NATIVO React (#cadastro) — home e produtos ===
    // Não criar form standalone. A calculadora vai logo ACIMA do #cadastro.
    var cad = document.getElementById("cadastro");
    if (cad) {
      removeById("ct-bottom-block");
      removeById("ct-contact-section"); // remove qualquer 2º form duplicado
      if (wantCalc && cad.parentNode) {
        var calc = document.getElementById("ct-calculator-section");
        if (!calc) calc = buildCalcSection();
        if (calc.nextElementSibling !== cad || calc.parentNode !== cad.parentNode) {
          cad.parentNode.insertBefore(calc, cad); // calc imediatamente antes do #cadastro
        }
      } else {
        removeById("ct-calculator-section");
      }
      return;
    }

    // Sem #cadastro a partir daqui (blog / artigos). Calc só existe onde há #cadastro.
    removeById("ct-calculator-section");

    // === CASO 2: blog landing — form ao lado do #sobre ===
    if (path === "/blog" && document.getElementById("sobre")) {
      removeById("ct-bottom-block");
      removeById("ct-contact-section");
      var shell = document.getElementById("ct-contact-form-shell");
      if (!shell) {
        shell = buildContactShell();
        bindLeadForm(shell);
      }
      placeBlogForm(shell);
      return;
    }

    // === CASO 3: obrigado — sem form ===
    if (path === "/obrigado") {
      removeById("ct-bottom-block");
      removeById("ct-contact-section");
      return;
    }

    // === CASO 4: artigos / demais — form standalone no fim do main ===
    removeById("ct-bottom-block");
    var fsec = document.getElementById("ct-contact-section");
    if (!fsec) fsec = buildStandaloneFormSection();
    if (fsec.parentNode !== main || main.lastElementChild !== fsec) {
      main.appendChild(fsec);
    }
  }

  function currentPath() {
    var p = (window.location.pathname || "/").replace(/\/+$/, "");
    return p === "" ? "/" : p;
  }

  // ===== Busca do blog (a busca nativa só filtrava 3 categorias hardcoded) =====
  // Filtro vanilla: casa o texto do card de artigo com o termo; esconde os demais.
  function getBlogCards() {
    var links = document.querySelectorAll('a[href^="/blog/artigos/"]');
    var seen = [];
    var cards = [];
    for (var i = 0; i < links.length; i++) {
      var card = links[i].closest('[class~="rounded-lg"][class~="overflow-hidden"]');
      if (card && seen.indexOf(card) === -1) {
        seen.push(card);
        cards.push(card);
      }
    }
    return cards;
  }

  function ctNorm(s) {
    // minúsculas + remove acentos (busca tolerante: "tungstenio" acha "Tungstênio")
    return (s || "")
      .normalize("NFD")
      .replace(/[̀-ͯ]/g, "")
      .toLowerCase();
  }

  function filterBlogArticles(query) {
    var q = ctNorm(query).trim();
    var cards = getBlogCards();
    if (!cards.length) return;
    for (var i = 0; i < cards.length; i++) {
      var text = ctNorm(cards[i].textContent);
      cards[i].style.display = !q || text.indexOf(q) !== -1 ? "" : "none";
    }
  }

  // Reaplica/reseta a cada tick: se a busca foi fechada (input sumiu) → mostra todos.
  function syncBlogSearch() {
    if (currentPath().indexOf("/blog") !== 0) return;
    var input = document.querySelector('input[placeholder="Procurar..."]');
    filterBlogArticles(input ? input.value : "");
  }

  function buildContactShell() {
    var shell = document.createElement("div");
    shell.id = "ct-contact-form-shell";
    shell.innerHTML = [
      '<div id="formulario-contato">',
      '  <div class="ct-contact-form-header">',
      "    <h3>Fale com a Cont.Tool</h3>",
      "    <p>Preencha seus dados e nosso time entra em contato.</p>",
      "  </div>",
      '  <form id="ct-contact-lead-form" novalidate>',
      '    <div class="ct-form-grid">',
      '      <label>Nome completo *<input name="nome_completo" type="text" autocomplete="name" placeholder="Seu nome" /></label>',
      '      <label>WhatsApp / Telefone *<input name="telefone_whatsapp" type="tel" autocomplete="tel" placeholder="(00) 00000-0000" /></label>',
      "    </div>",
      '    <div class="ct-form-grid">',
      '      <label>E-mail<input name="email_corporativo" type="email" autocomplete="email" placeholder="nome@empresa.com.br" /></label>',
      '      <label>Empresa<input name="empresa" type="text" autocomplete="organization" placeholder="Nome da empresa" /></label>',
      "    </div>",
      '    <button type="submit">Enviar</button>',
      '    <div id="ct-contact-form-status" aria-live="polite"></div>',
      "  </form>",
      "</div>",
    ].join("");
    return shell;
  }

  function bindLeadForm(shell) {
    var leadForm = shell.querySelector("#ct-contact-lead-form");
    if (leadForm) {
      leadForm.addEventListener("submit", handleContactFormSubmit);
    }
  }

  // Home: substitui o formulário React existente (#cadastro) pelo lead form.
  // Demais páginas (produtos/blog/artigos) usam ensureBottomSections().
  function injectContactForm() {
    if (document.getElementById("ct-contact-form-shell")) return;
    var reactForm = document.querySelector("#cadastro form");
    if (!reactForm) return;
    var shell = buildContactShell();
    reactForm.replaceWith(shell);
    bindLeadForm(shell);
  }

  async function handleContactFormSubmit(event) {
    event.preventDefault();

    var form = event.currentTarget;
    if (!form) return;

    // Validação dos campos obrigatórios
    var nomeInput = form.querySelector('[name="nome_completo"]');
    var telefoneInput = form.querySelector('[name="telefone_whatsapp"]');
    var hasError = false;

    [nomeInput, telefoneInput].forEach(function (input) {
      if (!input) return;
      var label = input.closest("label");
      var existing = label && label.querySelector(".ct-field-error-msg");
      if (existing) existing.remove();
      if (label) label.classList.remove("ct-field-error");

      if (!input.value.trim()) {
        hasError = true;
        if (label) {
          label.classList.add("ct-field-error");
          var msg = document.createElement("span");
          msg.className = "ct-field-error-msg";
          msg.textContent = "Campo obrigatório";
          label.appendChild(msg);
        }
      }
    });

    if (hasError) return;

    var submitButton = form.querySelector("button[type='submit']");
    var status = form.querySelector("#ct-contact-form-status");

    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = "Enviando...";
    }
    if (status) {
      status.textContent = "";
      status.dataset.state = "";
    }

    try {
      var formData = new FormData(form);
      var jsonBody = {};
      formData.forEach(function(value, key) { jsonBody[key] = value; });

      var response = await fetch(CONTACT_FORM_ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify(jsonBody),
      });

      var payload = await response.json().catch(function () { return {}; });

      if (!response.ok || payload.success === false || payload.success === "false") {
        throw new Error(payload.message || "Falha ao enviar.");
      }

      // Substitui o conteúdo do card por mensagem de sucesso
      var card = document.getElementById("formulario-contato");
      if (card) {
        card.innerHTML = [
          '<div id="ct-contact-success">',
          '  <div class="ct-success-icon">✓</div>',
          "  <h3>Mensagem enviada!</h3>",
          "  <p>Recebemos seus dados e nosso time entrará em contato em breve pelo WhatsApp ou e-mail.</p>",
          "</div>",
        ].join("");
      }
    } catch (error) {
      if (status) {
        status.dataset.state = "error";
        status.textContent =
          "Não foi possível enviar agora. Tente novamente ou escreva para contato@conttool.com.";
      }
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = "Enviar";
      }
    }
  }

  function bindGlobalEvents() {
    if (window.__ctPopupEventsBound) return;
    window.__ctPopupEventsBound = true;

    document.addEventListener("click", function (event) {
      var trigger = event.target.closest("a,button,[role='button']");
      if (!trigger) return;
      if (trigger.closest("#ct-google-form-modal")) return;

      if (isContactTrigger(trigger)) {
        event.preventDefault();
        event.stopPropagation();
        scrollToContactForm();
      }
    }, true);

    // Busca do blog: filtra os cards ao digitar (input nativo "Procurar...")
    document.addEventListener("input", function (event) {
      var t = event.target;
      if (t && t.getAttribute && t.getAttribute("placeholder") === "Procurar...") {
        filterBlogArticles(t.value);
      }
    });

    document.addEventListener("keydown", function (event) {
      if (event.key === "Escape") closeModal();
    });

    window.addEventListener("pageshow", function () { closeModal(); });
    document.addEventListener("visibilitychange", function () {
      if (document.hidden) return;
      if (!overlay || !overlay.classList.contains("open")) {
        document.body.style.overflow = "";
      }
    });
  }

  function observeDom() {
    if (window.__ctPopupObserverBound) return;
    window.__ctPopupObserverBound = true;

    var observer = new MutationObserver(function (mutations) {
      mutations.forEach(function (mutation) {
        mutation.addedNodes.forEach(function (node) {
          if (node && node.nodeType === 1) {
            injectContactForm();
            ensureBottomSections();
            syncBlogSearch();
          }
        });
      });
    });

    observer.observe(document.documentElement, {
      childList: true,
      subtree: true,
    });
  }

  function init() {
    injectStyles();
    addFloatingButton();
    injectContactForm();
    ensureBottomSections();
    syncBlogSearch();
    ensureModal();
    bindGlobalEvents();
    observeDom();

    window.openContactFormPopup = scrollToContactForm;
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
