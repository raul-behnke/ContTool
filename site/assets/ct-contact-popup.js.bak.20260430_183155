    });

    var categoryLink = card.querySelector("a[href^='/blog/categoria/']");
    if (categoryLink) categoryLink.setAttribute("href", NEW_ARTICLE.categoryHref);

    var categoryBadge = categoryLink ? categoryLink.querySelector("span") : null;
    if (categoryBadge) categoryBadge.textContent = NEW_ARTICLE.category;

    var image = card.querySelector("img");
    if (image) {
      image.setAttribute("src", NEW_ARTICLE.image);
      image.setAttribute("alt", NEW_ARTICLE.title);
    }

    var title = card.querySelector("h3");
    if (title) title.textContent = NEW_ARTICLE.title;

    var excerpt = card.querySelector("p.text-gray-600");
    if (excerpt) excerpt.textContent = NEW_ARTICLE.excerpt;

    var dateNode = card.querySelector(".flex.items-center.text-xs.text-gray-500.mb-3.gap-2 span");
    if (dateNode) dateNode.textContent = NEW_ARTICLE.date;
  }

