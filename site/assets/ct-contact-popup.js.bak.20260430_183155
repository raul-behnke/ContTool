    var form = currentForm.querySelector("#ct-contact-lead-form");
    if (form) {
      form.addEventListener("submit", handleContactFormSubmit);
    }
  }

  async function handleContactFormSubmit(event) {
    event.preventDefault();

    var form = event.currentTarget;
    if (!form) return;

    var submitButton = form.querySelector("button[type='submit']");
    var status = form.querySelector("#ct-contact-form-status");

    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = "Enviando...";
    }

    if (status) {
      status.textContent = "";
      status.dataset.state = "";
    }

    try {
      var response = await fetch(CONTACT_FORM_ENDPOINT, {
        method: "POST",
        headers: {
          Accept: "application/json",
        },
        body: new FormData(form),
      });

      var payload = await response.json().catch(function () {
        return {};
      });

      if (!response.ok || payload.success === "false") {
        throw new Error(payload.message || "Falha ao enviar o formulário.");
      }

      form.reset();
      if (status) {
        status.dataset.state = "success";
        status.textContent =
          "Recebemos seus dados. Nosso time entrará em contato em breve.";
      }
    } catch (error) {
      if (status) {
        status.dataset.state = "error";
        status.textContent =
          "Não foi possível enviar agora. Tente novamente em instantes ou escreva para contato@conttool.com.";
      }
    } finally {
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = "Falar com a Cont.Tool";
      }
    }
  }

  function bindGlobalEvents() {
    if (window.__ctPopupEventsBound) return;
    window.__ctPopupEventsBound = true;

    document.addEventListener("click", function (event) {
      var trigger = event.target.closest("a,button,[role='button']");
      if (!trigger) return;
      if (trigger.closest("#ct-google-form-modal")) return;

      if (isContactTrigger(trigger)) {
        event.preventDefault();
        event.stopPropagation();
        scrollToContactForm();
      }
    }, true);

    document.addEventListener("keydown", function (event) {
      if (event.key === "Escape") closeModal();
    });
  }

  function observeDom() {
    if (window.__ctPopupObserverBound) return;
    window.__ctPopupObserverBound = true;

    var observer = new MutationObserver(function (mutations) {
      mutations.forEach(function (mutation) {
        mutation.addedNodes.forEach(function (node) {
          if (node && node.nodeType === 1) {
            removeForms(node);
            applyCadastroLayout(node);
            injectGeneralArticlesCard(node);
            injectCalculatorSection(node);
          }
        });
      });
    });

    observer.observe(document.documentElement, {
      childList: true,
      subtree: true,
    });
  }

  function init() {
    injectStyles();
    removeForms(document);
    addFloatingButton();
    applyCadastroLayout(document);
    injectGeneralArticlesCard(document);
    injectCalculatorSection(document);
    ensureModal();
    bindGlobalEvents();
    observeDom();

    window.openContactFormPopup = scrollToContactForm;
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
